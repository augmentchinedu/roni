{
  "name": "roni",
  "version": "0.2.0",
  "description": "Roni OS — Node + Chromium + Vue desktop operating system",
  "type": "module",
  "private": true,
  "workspaces": [
    "kernel",
    "compositor",
    "sdk",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev:kernel & npm run dev:compositor",
    "dev:kernel": "node --watch kernel/boot.js --dev",
    "dev:compositor": "vite compositor",
    "bundle": "rollup -c rollup.config.mjs",
    "build": "npm run build:compositor && npm run build:sdk",
    "build:compositor": "vite build compositor",
    "build:sdk": "node scripts/build-sdk.js",
    "boot": "node kernel/boot.js",
    "lint": "eslint . --ext .js,.vue"
  },
  "dependencies": {
    "@rollup/plugin-json": "^6.1.0",
    "pinia": "^2.1.0",
    "vue": "^3.4.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@vitejs/plugin-vue": "^5.0.0",
    "eslint": "^9.0.0",
    "vite": "^5.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
